# Install as ~/.config/systemd/user/paperfull.service, then:
#   systemctl --user daemon-reload && systemctl --user enable --now paperfull
[Unit]
Description=paperfull document archive
After=network.target

[Service]
ExecStart=%h/.local/bin/paperfull
Environment=PAPERFULL_DATA=%h/.local/share/paperfull
Environment=PAPERFULL_CONSUME=%h/Scans/inbox
Environment=PAPERFULL_LISTEN=127.0.0.1:8484
# Environment=PAPERFULL_TOKEN=change-me
Restart=on-failure
Nice=5

[Install]
WantedBy=default.target
