# Read by paperfull.service (system) and, as ~/.config/paperfull.env, by the
# user service. Every option of `paperfull -h` works here as PAPERFULL_...

# Where it listens. Set a password before opening it to the network.
#PAPERFULL_LISTEN=127.0.0.1:8484
#PAPERFULL_TOKEN=

# The folder watched for new scans (empty = off).
#PAPERFULL_CONSUME=

# OCR languages, as installed tesseract-data-* packages.
#PAPERFULL_OCR_LANG=deu+eng

# AI suggestions through a local Ollama.
#PAPERFULL_AI_URL=http://127.0.0.1:11434
#PAPERFULL_AI_MODEL=qwen2.5:7b

# LibreOffice for office file previews: auto, off, or the path to soffice.
#PAPERFULL_LIBREOFFICE=auto
