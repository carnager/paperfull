[Unit]
Description=paperfull document archive
Documentation=file:///usr/share/doc/paperfull-git/README.md
Wants=network-online.target
After=network-online.target

[Service]
Environment=PAPERFULL_DATA=%h/.local/share/paperfull
Environment=PAPERFULL_CONSUME=%h/Scans/inbox
Environment=PAPERFULL_LISTEN=127.0.0.1:8484
EnvironmentFile=-%E/paperfull.env
ExecStart=/usr/bin/paperfull
WorkingDirectory=%h
Restart=on-failure
RestartSec=2
Nice=5

[Install]
WantedBy=default.target
